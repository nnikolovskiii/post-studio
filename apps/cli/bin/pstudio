#!/usr/bin/env bash
# pstudio — Post Studio agent CLI. Runs the TypeScript sources through tsx (no build step).
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
root="$(cd "$here/../../.." && pwd)"
exec "$root/node_modules/.bin/tsx" "$root/apps/cli/src/main.ts" "$@"
