# Post Studio: every environment variable the code reads, with its default.
# Nothing here is required for a local run. The code does not load this file itself:
# copy it to .env, edit, then `set -a; . ./.env; set +a` before `pstudio serve` / `pstudio dispatch run`.
# deploy/.env.example is a different file: the overrides deploy/compose.yaml interpolates.
# No secrets belong here. The editor password and API tokens are created with `pstudio admin set-password`
# and `pstudio token create`; only their hashes live in the database.

# --- Server (apps/server, also `pstudio serve` and the admin commands that open the data dir)
# Data dir: SQLite file, assets, backups, rendered videos. Default $XDG_DATA_HOME/post-studio or ~/.local/share/post-studio
POST_STUDIO_DATA=./.data
# Listen address. Keep 127.0.0.1 unless a reverse proxy sits in front (the container uses 0.0.0.0).
POST_STUDIO_HOST=127.0.0.1
# Listen port (also the default for `pstudio serve --port`).
POST_STUDIO_PORT=3472
# Base URL used for the editor links the API returns (editorUrl). Default http://<host>:<port>
POST_STUDIO_PUBLIC_URL=http://127.0.0.1:3472
# Trusted reverse proxies for X-Forwarded-For: empty = none, "true" = any, or a comma list of CIDRs.
POST_STUDIO_TRUST_PROXY=
# Session cookie Secure flag: "auto" (from the request) or "always" (behind HTTPS).
POST_STUDIO_SECURE_COOKIES=auto

# --- Video export (server and `pstudio video`)
# ffmpeg binary. Empty = first ffmpeg on PATH, then ~/.local/bin/ffmpeg.
POST_STUDIO_FFMPEG=
# Encodes running at the same time (up to 8 more wait in a queue).
POST_STUDIO_VIDEO_JOBS=1
# Frames rasterized at the same time per encode.
POST_STUDIO_VIDEO_CONCURRENCY=3
# x264 threads (0 = ffmpeg's own choice).
POST_STUDIO_VIDEO_THREADS=4
# Rendered-video cache: newest N files, and at most this many MB.
POST_STUDIO_VIDEO_KEEP=20
POST_STUDIO_VIDEO_CACHE_MB=2048

# --- CLI (apps/cli, `pstudio`)
# Server the CLI talks to (same as --url).
PSTUDIO_URL=http://127.0.0.1:3472
# Bearer token. Empty = read $XDG_CONFIG_HOME/post-studio/token (default ~/.config/post-studio/token).
PSTUDIO_TOKEN=

# --- Hand-off dispatcher (`pstudio dispatch run`, deploy/post-studio-dispatch.service)
# Folder that holds the agent session runner and this repo. Default: the parent of the repo.
POST_STUDIO_WORKSPACE=
# Runner command (space-separated argv prefix). Default: python3 <workspace>/telegram-mcp/bin/sessions.py
POST_STUDIO_SESSIONS=
# Dispatcher token file (an agent token that may only call /v1/dispatch/*). Default ~/.config/post-studio/dispatcher-token
POST_STUDIO_DISPATCH_TOKEN_FILE=
# Values passed to the runner's `start` command.
POST_STUDIO_DISPATCH_KIND=claude
POST_STUDIO_DISPATCH_MODEL=claude-opus-5-5
POST_STUDIO_DISPATCH_BOT=optibot
# Telegram chat id for the "job started" ping (and passed to the runner). Empty = no usable ping target.
POST_STUDIO_DISPATCH_CHAT=
# Env file that holds TELEGRAM_BOT_TOKEN=... for that ping (read per message, never logged).
# Default ~/.config/optibot/telegram-mcp.env
POST_STUDIO_TELEGRAM_ENV=
# "off" = silence the started ping only.
POST_STUDIO_DISPATCH_PINGS=on
# "off" = keep polling but start nothing (the editor then says auto-start is off).
POST_STUDIO_DISPATCH=on
# Kill-switch file: while it exists, nothing starts. Default ~/.config/post-studio/dispatch.off
POST_STUDIO_DISPATCH_OFF_FILE=
# At most this many hand-off jobs queued or running at once.
POST_STUDIO_DISPATCH_MAX=2
# Poll interval in seconds (minimum 5).
POST_STUDIO_DISPATCH_POLL_SECONDS=20

# --- Backups (deploy/backup.sh)
# Number of backup tarballs to keep.
POST_STUDIO_BACKUP_KEEP=14

# --- Standard locations (only if you want them elsewhere)
# XDG_CONFIG_HOME=~/.config         tokens, dispatcher token, kill-switch file
# XDG_DATA_HOME=~/.local/share      default data dir parent
# XDG_STATE_HOME=~/.local/state     dispatcher prompt files

# --- Tests and tools
# Vitest worker processes (default 2; 1 on small machines).
VITEST_MAX_FORKS=2
# Chrome / Chromium binary for the editor e2e and Chrome cross-check tests.
# Empty = newest Playwright headless shell in ~/.cache/ms-playwright; tests skip when none is found.
CHROME=
# Extra shared libraries for the headless shell on minimal hosts (extracted .deb roots).
CHROME_LIBS=
# Set to 1 to keep screenshots and numbers from an e2e file under test-artifacts/:
# PHASE3_EVIDENCE PHASE4_EVIDENCE PHASE5_EVIDENCE PHASE8_EVIDENCE HANDOFF_EVIDENCE MOTION3_EVIDENCE
# MOTION4_EVIDENCE FRAMES_EVIDENCE FIGMA_EVIDENCE SKETCH_EVIDENCE MULTI_EVIDENCE
# Set to 1 to rewrite the palette golden file (fixtures) from the Python checker.
UPDATE_PALETTE_GOLDEN=
