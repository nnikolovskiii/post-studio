# Optional overrides for deploy/compose.yaml (copy to deploy/.env). No secrets belong here:
# the editor password and the agent tokens live as hashes in the SQLite file, and their
# plain values only in ~/.config/post-studio/ (0600) on the machines that use them.
POST_STUDIO_DOMAIN=studio.example.com
# Host data dir (outside Syncthing). Bind-mounted at /data.
POST_STUDIO_DATA_HOST=/srv/post-studio
# Loopback port for agents on this machine (http://127.0.0.1:3472).
POST_STUDIO_LOCAL_PORT=3472
# Subnet of the external `proxy` Docker network (docker network inspect proxy).
POST_STUDIO_TRUST_PROXY=172.18.0.0/16
